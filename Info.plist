<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>            <string>NoneNote</string>
	<key>CFBundleDisplayName</key>     <string>NoneNote</string>
	<key>CFBundleIdentifier</key>      <string>com.noty.macos</string>
	<key>CFBundleExecutable</key>      <string>Noty</string>
	<key>CFBundleIconFile</key>        <string>AppIcon</string>
	<key>CFBundlePackageType</key>     <string>APPL</string>
	<key>CFBundleShortVersionString</key> <string>1.3.2</string>
	<key>CFBundleVersion</key>         <string>1</string>
	<key>LSMinimumSystemVersion</key>  <string>15.0</string>
	<key>LSUIElement</key>             <true/>
	<key>NSHighResolutionCapable</key> <true/>
	<key>NSHumanReadableCopyright</key><string>Sticky notes docked to the screen edge.</string>

	<!-- Pointed at our own appcast: while this named the upstream feed the
	     updater read aimen08/noty's releases and would offer to replace this
	     app with upstream's build. SUPublicEDKey must be the public half of
	     the key whose private half signs the DMGs (SPARKLE_PRIVATE_KEY). -->
	<key>SUFeedURL</key>               <string>https://raw.githubusercontent.com/91zgaoge/NoneNote-macOS/main/appcast.xml</string>
	<key>SUPublicEDKey</key>           <string>P3gLRgblQ4jyeOn+sDEQBLJz6xhMGvZ4KqNct/D6Ge8=</string>
	<key>SUEnableAutomaticChecks</key> <true/>
	<key>SUScheduledCheckInterval</key><integer>86400</integer>
	<key>SUAllowsAutomaticUpdates</key><false/>
</dict>
</plist>
